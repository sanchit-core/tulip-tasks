# Maintainer: Sanchit Core <me@sanchit-core.com>
pkgname=tulip-tasks
pkgver=0.1.5
pkgrel=1
pkgdesc="Neo-brutalist task board with calendar, backlog inbox and recurring tasks"
arch=('x86_64')
url="https://github.com/sanchit-core/tulip-tasks"
license=('MIT')
depends=()
makedepends=()
options=(!strip !emptydirs)

# Download AppImage from GitHub release
source=("tulip-tasks-0.1.5-x86_64.AppImage::https://github.com/sanchit-core/tulip-tasks/releases/download/v0.1.5/tulip-tasks_0.1.5_linux_x86_64.AppImage")
sha256sums=('SKIP')

package() {
  # Create installation directory
  install -d "$pkgdir/opt/tulip-tasks"
  install -d "$pkgdir/usr/bin"
  install -d "$pkgdir/usr/share/applications"
  install -d "$pkgdir/usr/share/icons/hicolor/256x256/apps"

  # Install AppImage
  install -m755 "$srcdir/tulip-tasks-0.1.5-x86_64.AppImage" "$pkgdir/opt/tulip-tasks/tulip-tasks.AppImage"

  # Create symlink in /usr/bin
  ln -sf /opt/tulip-tasks/tulip-tasks.AppImage "$pkgdir/usr/bin/tulip-tasks"

  # Install license
  install -Dm644 "$srcdir/$pkgname-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  # Extract .desktop from AppImage to get icon information
  extract_dir="$pkgdir/opt/tulip-tasks/extract"
  install -d "$extract_dir"
  if "$srcdir/tulip-tasks-0.1.5-x86_64.AppImage" --appimage-extract 2>/dev/null; then
      # Copy the .desktop file
      if [ -f "$extract_dir/tulip-tasks.desktop" ]; then
          cp "$extract_dir/tulip-tasks.desktop" "$pkgdir/usr/share/applications/tulip-tasks.desktop"
      fi
      # Copy the icon if available
      if [ -f "$extract_dir/tulip-tasks.svg" ] || [ -f "$extract_dir/tulip-tasks.png" ]; then
          cp "$extract_dir/tulip-tasks.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/tulip-tasks.png" 2>/dev/null || true
      fi
  fi

  # Create .desktop entry as fallback
  if [ ! -f "$pkgdir/usr/share/applications/tulip-tasks.desktop" ]; then
      cat > "$pkgdir/usr/share/applications/tulip-tasks.desktop" << DESKTOP_EOF
[Desktop Entry]
Name=Tulip Tasks
Comment=A neo-brutalist task board with calendar, backlog inbox and recurring tasks
Exec=/usr/bin/tulip-tasks
Terminal=false
Type=Application
Icon=/usr/bin/tulip-tasks
Categories=Utility;Organization;
X-Comment=Tulip Tasks 0.1.5
DESKTOP_EOF
  fi

  # Try to update icon cache
  if [ -x /usr/bin/update-icon-caches ]; then
      /usr/bin/update-icon-caches /usr/share/icons/hicolor/ 2>/dev/null || true
  fi
}