{
  "name": "tulip-kanban",
  "version": "0.1.0",
  "description": "Tulip Kanban — a neo-brutalist kanban board with calendar, backlog inbox and recurring tasks",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": ". \"$HOME/.config/tauri-build/env.sh\" && tauri",
    "tauri:build": ". \"$HOME/.config/tauri-build/env.sh\" && tauri build",
    "package:tar": ". \"$HOME/.config/tauri-build/env.sh\" && tauri build --no-bundle && tar -czf \"src-tauri/target/release/bundle/tulip-kanban_${npm_package_version}_linux-x86_64.tar.gz\" -C src-tauri/target/release tulip-kanban"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.5"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
