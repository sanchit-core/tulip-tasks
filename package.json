{
  "name": "tulip-tasks",
  "version": "1.0.2",
  "description": "Tulip Tasks — a neo-brutalist task board with calendar, backlog inbox and recurring tasks",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "version:patch": "npm version patch --no-git-tag-version && node scripts/sync-version.cjs",
    "version:minor": "npm version minor --no-git-tag-version && node scripts/sync-version.cjs",
    "version:major": "npm version major --no-git-tag-version && node scripts/sync-version.cjs",
    "release": "npm run check && npm test && npm run build && git diff --quiet || (echo 'Working tree dirty - commit changes first' && exit 1)",
    "tauri": ". \"$HOME/.config/tauri-build/env.sh\" && tauri",
    "tauri:build": ". \"$HOME/.config/tauri-build/env.sh\" && tauri build",
    "package:tar": ". \"$HOME/.config/tauri-build/env.sh\" && tauri build --no-bundle && tar -czf \"src-tauri/target/release/bundle/tulip-tasks_${npm_package_version}_linux-x86_64.tar.gz\" -C src-tauri/target/release tulip-tasks"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.5"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "node-localstorage": "^3.0.5",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.3"
  }
}
