# Maintainer: Sanchit Core <me@sanchit-core.com>
pkgname=tulip-tasks
pkgver=1.0.2
pkgrel=1
pkgdesc="Neo-brutalist task board with calendar, backlog inbox and recurring tasks"
url="https://github.com/sanchit-core/tulip-tasks"
license=('MIT')
depends=()
makedepends=()
options=(!strip !emptydirs)

# Download AppImage from GitHub release
source=("tulip-tasks-1.0.2-x86_64.AppImage::https://github.com/sanchit-core/tulip-tasks/releases/download/v1.0.2/tulip-tasks_1.0.2_linux_x86_64.AppImage")
sha256sums=('SKIP')

package() {
  # Create installation directory
  install -d "$pkgdir/opt/tulip-tasks"
  install -d "$pkgdir/usr/bin"
  install -d "$pkgdir/usr/share/applications"
  install -d "$pkgdir/usr/share/icons/hicolor/scalable/apps"

  # Download and install AppImage
  srcdir_app="$srcdir/tulip-tasks-1.0.2-x86_64.AppImage"
  install -m755 "$srcdir_app" "$pkgdir/opt/tulip-tasks/tulip-tasks.AppImage"

  # Create symlink in /usr/bin
  ln -sf /opt/tulip-tasks/tulip-tasks.AppImage "$pkgdir/usr/bin/tulip-tasks"

  # Install license
  install -Dm644 "$srcdir/tulip-tasks-1.0.2/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  # Extract .desktop and icon from AppImage
  extract_dir="$pkgdir/opt/tulip-tasks/extract"
  install -d "$extract_dir"
  if "$srcdir_app" --appimage-extract 2>/dev/null; then
    # Install the .desktop file
    if [ -f "$extract_dir/tulip-tasks.desktop" ]; then
      install -Dm644 "$extract_dir/tulip-tasks.desktop" "$pkgdir/usr/share/applications/tulip-tasks.desktop"
    fi
    # Install the icon if available
    if [ -f "$extract_dir/tulip-tasks.svg" ]; then
      install -Dm644 "$extract_dir/tulip-tasks.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/tulip-tasks.svg"
    fi
    if [ -f "$extract_dir/tulip-tasks.png" ]; then
      install -Dm644 "$extract_dir/tulip-tasks.png" "$pkgdir/usr/share/icons/hicolor/scalable/apps/tulip-tasks.png"
    fi
  fi

  # Fallback .desktop entry if extraction failed
  if [ ! -f "$pkgdir/usr/share/applications/tulip-tasks.desktop" ]; then
    cat > "$pkgdir/usr/share/applications/tulip-tasks.desktop" << DESKTOP_EOF
[Desktop Entry]
Name=Tulip Tasks
Comment=A neo-brutalist task board with calendar, backlog inbox and recurring tasks
Exec=/usr/bin/tulip-tasks
Terminal=false
Type=Application
Icon=/usr/share/icons/hicolor/scalable/apps/tulip-tasks.svg
Categories=Utility;Organization;
X-Comment=Tulip Tasks 1.0.2
DESKTOP_EOF
  fi

  # Try to update icon cache
  if [ -x /usr/bin/update-icon-caches ]; then
      /usr/bin/update-icon-caches /usr/share/icons/hicolor/ 2>/dev/null || true
  fi
}